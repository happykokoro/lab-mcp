# lab-mcp environment variables
# Copy to .env (or export in your shell) and fill in operator-specific values.

# --- MCP transport ---
# "http" exposes a Streamable HTTP server on MCP_PORT.
# "stdio" runs over stdin/stdout (typical for Claude Code launching the binary directly).
MCP_TRANSPORT=http
MCP_PORT=3100

# --- Backend service URLs (operator-supplied) ---
# Lab service: signals, factors, predictions, polymarket, quant-tools, backtests, alerts...
LAB_URL=http://localhost:4100
# Pricing service: token pricing, candles.
PRICING_URL=http://localhost:4002
# Platform service: auth (/api/auth/me), bot lifecycle, artifacts, data sources, admin.
PLATFORM_URL=http://localhost:4000
# Terminal service: market-data terminal API.
TERMINAL_URL=http://localhost:4200

# --- Auth ---
# Bearer token used by lab-mcp to call Platform endpoints (admin, artifacts, data sources, engine).
API_KEY=

# --- HTTP transport ---
# Single CORS origin allowed by the HTTP transport. Set to your frontend's origin in production.
CORS_ORIGIN=http://localhost:3001

# --- Optional: tier-upgrade URL ---
# If set, surfaced in 401/403 error messages so callers know where to manage keys / upgrade.
# Leave empty to omit URL hints from error messages.
UPGRADE_URL=
